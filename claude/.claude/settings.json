{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "ENABLE_WRITE_TOOLS": "true"
  },
  "permissions": {
    "allow": [
      "Bash(curl:*)",
      "Bash(echo echo '--- Searching for freezing/defrosting ---' curl -s http://localhost:9200/articles_vectors/_search?pretty -H 'Content-Type: application/json' -d '{\n  \"\"\"\"_source\"\"\"\": [\"\"\"\"payload.ID\"\"\"\", \"\"\"\"payload.title\"\"\"\"],\n  \"\"\"\"size\"\"\"\": 10,\n  \"\"\"\"query\"\"\"\": {\n    \"\"\"\"match\"\"\"\": {\"\"\"\"payload.title\"\"\"\": \"\"\"\"congelar\"\"\"\"}\n  }\n}')",
      "Bash(echo echo '--- Searching for account cancellation status ---' curl -s http://localhost:9200/articles_vectors/_search?pretty -H 'Content-Type: application/json' -d '{\n  \"\"\"\"_source\"\"\"\": [\"\"\"\"payload.ID\"\"\"\", \"\"\"\"payload.title\"\"\"\"],\n  \"\"\"\"size\"\"\"\": 10,\n  \"\"\"\"query\"\"\"\": {\n    \"\"\"\"bool\"\"\"\": {\n      \"\"\"\"must\"\"\"\": [\n        {\"\"\"\"match\"\"\"\": {\"\"\"\"payload.title\"\"\"\": \"\"\"\"cancelación cuenta\"\"\"\"}},\n        {\"\"\"\"match\"\"\"\": {\"\"\"\"payload.title\"\"\"\": \"\"\"\"estado\"\"\"\"}}\n      ]\n    }\n  }\n}')",
      "mcp__atlassian__getConfluenceSpaces",
      "mcp__atlassian__getPagesInConfluenceSpace",
      "mcp__atlassian__searchConfluenceUsingCql",
      "mcp__atlassian__getConfluencePage",
      "mcp__atlassian__getConfluencePageDescendants",
      "mcp__atlassian__getAccessibleAtlassianResources",
      "Bash(python3:*)",
      "Bash(git worktree:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(uv run python:*)",
      "mcp__atlassian__getJiraIssue",
      "Bash(jq:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "mcp__gitlab__get_file_contents"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/notify-on-compact.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/vladislav.sorokin/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/notify-on-worktree-remove.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "fullstack-dev-skills": {
      "source": {
        "source": "github",
        "repo": "jeffallan/claude-skills"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "vladikk-modularity": {
      "source": {
        "source": "github",
        "repo": "vladikk/modularity"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
