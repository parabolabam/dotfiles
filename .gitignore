# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Compiled
*.zwc
*.pyc
__pycache__/

# Caches
.zcompdump*
.zsh_history
cache/

# Local overrides
*.local
.env

# Backup files
*.backup.*


# Herdr runtime state (~/.config/herdr is a whole-dir stow symlink into this
# repo, so the server writes its state here). Whitelist rather than blocklist:
# the server keeps adding state files (session.json, *.log, release-notes.json,
# .plugins.lock, session-history.json, ...) and only config.toml is portable.
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml
!herdr/.config/herdr/.gitkeep

# Claude Code hooks generated by other tools — herdr rewrites
# herdr-agent-state.sh on every `herdr integration install claude` and bumps its
# version, and rtk owns the sha256 stamp. Regenerated, not portable config.
claude/.claude/hooks/herdr-agent-state.sh
claude/.claude/hooks/.rtk-hook.sha256

# Claude Code (sensitive/machine-specific)
claude/.claude/settings.local.json
claude/.claude/history.jsonl
claude/.claude/stats-cache.json
claude/.claude/file-history/
claude/.claude/plans/
claude/.claude/debug/

# Gemini CLI (sensitive/machine-specific)
gemini/.gemini/oauth_creds.json
gemini/.gemini/google_accounts.json
gemini/.gemini/installation_id
gemini/.gemini/state.json
gemini/.gemini/tmp/
