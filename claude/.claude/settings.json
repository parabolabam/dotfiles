{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "ENABLE_WRITE_TOOLS": "true"
  },
  "permissions": {
    "allow": [
      "Bash(curl:*)",
      "Bash(echo echo '--- Searching for freezing/defrosting ---' curl -s http://localhost:9200/articles_vectors/_search?pretty -H 'Content-Type: application/json' -d '{\n  \"\"\"\"_source\"\"\"\": [\"\"\"\"payload.ID\"\"\"\", \"\"\"\"payload.title\"\"\"\"],\n  \"\"\"\"size\"\"\"\": 10,\n  \"\"\"\"query\"\"\"\": {\n    \"\"\"\"match\"\"\"\": {\"\"\"\"payload.title\"\"\"\": \"\"\"\"congelar\"\"\"\"}\n  }\n}')",
      "Bash(echo echo '--- Searching for account cancellation status ---' curl -s http://localhost:9200/articles_vectors/_search?pretty -H 'Content-Type: application/json' -d '{\n  \"\"\"\"_source\"\"\"\": [\"\"\"\"payload.ID\"\"\"\", \"\"\"\"payload.title\"\"\"\"],\n  \"\"\"\"size\"\"\"\": 10,\n  \"\"\"\"query\"\"\"\": {\n    \"\"\"\"bool\"\"\"\": {\n      \"\"\"\"must\"\"\"\": [\n        {\"\"\"\"match\"\"\"\": {\"\"\"\"payload.title\"\"\"\": \"\"\"\"cancelación cuenta\"\"\"\"}},\n        {\"\"\"\"match\"\"\"\": {\"\"\"\"payload.title\"\"\"\": \"\"\"\"estado\"\"\"\"}}\n      ]\n    }\n  }\n}')",
      "mcp__atlassian__getConfluenceSpaces",
      "mcp__atlassian__getPagesInConfluenceSpace",
      "mcp__atlassian__searchConfluenceUsingCql",
      "mcp__atlassian__getConfluencePage",
      "mcp__atlassian__getConfluencePageDescendants",
      "mcp__atlassian__getAccessibleAtlassianResources",
      "Bash(python3:*)",
      "Bash(git worktree:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(uv run python:*)",
      "mcp__atlassian__getJiraIssue",
      "Bash(jq:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "mcp__gitlab__get_file_contents",
      "Bash('/Users/vladislav.sorokin/.nvm/versions/node/v24.14.0/lib/node_modules/@llmtrim/cli/node_modules/@llmtrim/darwin-arm64/bin/llmtrim' window-sub slash *)"
    ],
    "defaultMode": "plan"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/notify-on-compact.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/vladislav.sorokin/.nvm/versions/node/v24.14.0/lib/node_modules/@llmtrim/cli/node_modules/@llmtrim/darwin-arm64/bin/llmtrim' window-sub hook-start # llmtrim-owned-window-sub-hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/vladislav.sorokin/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/notify-on-worktree-remove.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/vladislav.sorokin/.nvm/versions/node/v24.14.0/lib/node_modules/@llmtrim/cli/node_modules/@llmtrim/darwin-arm64/bin/llmtrim' window-sub hook-end # llmtrim-owned-window-sub-hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "gepa-optimize-anything@gepa": true,
    "cc-plugin-you-should-know@builtin": true,
    "skins@hellosverre-mods": true,
    "filetree@claude-code-filetree": true,
    "cache-tax@claude-code-mods": true,
    "savvy-progress@claude-kit": true,
    "savvy-flow@claude-kit": true,
    "redgreen@hellosverre-mods": true,
    "smart-compact@hellosverre-mods": true,
    "mod-store@hellosverre-mods": true,
    "image-peek@claude-code-mods": true,
    "mod-builder@claude-code-mods": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "vladikk-modularity": {
      "source": {
        "source": "github",
        "repo": "vladikk/modularity"
      }
    },
    "gepa": {
      "source": {
        "source": "github",
        "repo": "gepa-ai/gepa"
      }
    },
    "claude-kit": {
      "source": {
        "source": "github",
        "repo": "johnnyvizz/claude-kit"
      }
    },
    "hellosverre-mods": {
      "source": {
        "source": "github",
        "repo": "hellosverre/claude-skins"
      }
    },
    "claude-code-mods": {
      "source": {
        "source": "github",
        "repo": "karanb192/claude-code-mods"
      }
    },
    "claude-code-filetree": {
      "source": {
        "source": "github",
        "repo": "data-goblin/claude-code-filetree"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 400000,
  "advisorModel": "fable",
  "pluginConfigs": {
    "filetree@claude-code-filetree": {
      "options": {
        "activity": "writes",
        "glyphs": "nerd",
        "follow": "on",
        "start": "on",
        "column": "date",
        "hints": "on",
        "spacing": "on",
        "shortcuts": "auto",
        "open": "editor",
        "binaries": "Open with",
        "diff": "lazygit -f",
        "target": "pane right",
        "split": "bottom",
        "treemap": "off"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
